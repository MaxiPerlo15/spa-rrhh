generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([actorEmail, createdAt])
}

model AdminNotification {
  id        String            @id @default(cuid())
  title     String
  message   String
  level     NotificationLevel @default(INFO)
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([createdAt])
  @@index([isRead, createdAt])
}

model Vacancy {
  id           String          @id @default(cuid())
  title        String
  description  String
  location     String
  salary       String?
  requirements String?
  benefits     String?
  status       VacancyStatus   @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  modality     VacancyModality @default(ON_SITE)
  workday      VacancyWorkday  @default(FULL_TIME)
  applications Application[]

  @@index([status, createdAt])
}

model Application {
  id             String            @id @default(cuid())
  vacancyId      String
  candidateName  String
  email          String
  phone          String
  resumeFileName String?
  coverLetter    String?
  status         ApplicationStatus @default(PENDING)
  submittedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resumeKey      String?
  resumeUrl      String?
  vacancy        Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, status])
  @@index([email])
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

enum Role {
  ADMIN
  USER
}

enum VacancyWorkday {
  FULL_TIME
  PART_TIME
  PROJECT_BASED
  INTERNSHIP
}

enum VacancyModality {
  ON_SITE
  REMOTE
  HYBRID
}

enum VacancyStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

enum ContactStatus {
  PENDING
  RESPONDED
  ARCHIVED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
}
