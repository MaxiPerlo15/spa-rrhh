// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Vacantes/Ofertas Laborales
model Vacancy {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  location    String
  type        VacancyType
  salary      String?
  requirements String? @db.Text
  benefits    String?  @db.Text
  status      VacancyStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relación con postulaciones
  applications Application[]

  @@index([status, createdAt])
}

enum VacancyType {
  FULL_TIME
  PART_TIME
  FREELANCE
}

enum VacancyStatus {
  ACTIVE
  CLOSED
  DRAFT
}

// Modelo de Postulaciones
model Application {
  id              String   @id @default(cuid())
  vacancyId       String
  candidateName   String
  email           String
  phone           String
  resumeData      String?  @db.Text  // Base64 del CV
  resumeFileName  String?
  coverLetter     String?  @db.Text
  status          ApplicationStatus @default(PENDING)
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relación con vacante
  vacancy         Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, status])
  @@index([email])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// Modelo de Contactos
model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  subject     String
  message     String   @db.Text
  status      ContactStatus @default(PENDING)
  createdAt   DateTime @default(now())
  
  @@index([status, createdAt])
}

enum ContactStatus {
  PENDING
  RESPONDED
  ARCHIVED
}
