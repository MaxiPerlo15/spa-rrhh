generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// DORMANT — Admin auth migrated to Spring (Phase 4, PR 4).
// This table is retained for FK integrity with AdminAuditLog.actorUserId and
// AdminSettings.userId. Do NOT use for authentication — Spring Usuario is the
// source of truth for admin identity.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]
  adminSettings AdminSettings?

  @@index([email])
}

model AdminSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  notificationsEnabled  Boolean  @default(true)
  notifyNewApplications Boolean  @default(true)
  notifyNewContacts     Boolean  @default(true)
  notifySecurityAlerts  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DORMANT — Password reset migrated to Spring (Phase 4, PR 4).
// This table is retained for FK integrity. Do NOT use for password reset —
// Spring PasswordResetService is the source of truth.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([actorEmail, createdAt])
}

model AdminNotification {
  id        String            @id @default(cuid())
  title     String
  message   String
  level     NotificationLevel @default(INFO)
  isRead    Boolean           @default(false)
  actionLabel String?
  actionType AdminNotificationActionType?
  actionResourceId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([createdAt])
  @@index([isRead, createdAt])
}

model Vacancy {
  id           String          @id @default(cuid())
  title        String
  description  String
  location     String
  salary       String?
  requirements String?
  benefits     String?
  status       VacancyStatus   @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  modality     VacancyModality @default(ON_SITE)
  workday      VacancyWorkday  @default(FULL_TIME)

  @@index([status, createdAt])
}

model Candidate {
  id             String        @id @default(cuid())
  name           String
  lastName       String?
  email          String
  phone          String
  personKey      String        @unique
  resumeFileName String?
  resumeKey      String?
  resumeUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]

  @@index([email])
  @@index([personKey, createdAt])
}

model Application {
  id             String            @id @default(cuid())
  vacancyId      String?
  candidateId    String
  coverLetter    String?
  status         ApplicationStatus @default(PENDING)
  submittedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([vacancyId, status])
  @@index([candidateId, submittedAt])
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  personKey String?
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([personKey, createdAt])
}

enum Role {
  ADMIN
  USER
}

enum VacancyWorkday {
  FULL_TIME
  PART_TIME
  PROJECT_BASED
  INTERNSHIP
}

enum VacancyModality {
  ON_SITE
  REMOTE
  HYBRID
}

enum VacancyStatus {
  ACTIVE
  INACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

enum ContactStatus {
  PENDING
  RESPONDED
  ARCHIVED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
}

enum AdminNotificationActionType {
  VACANCY
  APPLICATION
  CONTACT
}
