{
  "name": "spa-rrhh",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:matrix": "playwright test tests/e2e/qa-matrix.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "env:check": "dotenv -e .env -- tsx scripts/check-env.ts",
    "env:check:prod": "dotenv -e .env -- tsx scripts/check-env.ts --prod",
    "predeploy:check": "npm run env:check:prod && npm run test:e2e:matrix && npm run build",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e .env -- npx prisma migrate reset --force",
    "db:verify": "dotenv -e .env -- tsx scripts/verify-admin.ts"
  },
  "prisma": {
    "seed": "dotenv -e .env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.4.0",
    "@sentry/nextjs": "^10.30.0",
    "@types/bcrypt": "^6.0.0",
    "@uploadthing/react": "^7.3.3",
    "bcrypt": "^6.0.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.16.3",
    "prisma": "^7.4.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.6.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__react": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
