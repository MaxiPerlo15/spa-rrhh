# Environment variables for local development
# Copy this file to .env and fill in your values

# PostgreSQL Database URL
# Format: postgresql://USER@HOST:PORT/DATABASE?schema=SCHEMA
# Railway/Neon production note: with the current pg.Pool + PrismaPg setup,
# prefer Neon pooled connection strings (pooler host + SSL enabled).
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/spa_rrhh_db?schema=public"

# Next.js
# NEXT_PUBLIC_ variables are exposed to the browser
NODE_ENV=development
# Optional: when set, Next.js API routes proxy migrated vacancy use cases to Spring Boot.
BACKEND_URL=http://localhost:8080
# Required whenever BACKEND_URL is configured in production. Generate a unique token
# and set it in your ignored local .env; it must match RRHH_SECURITY_INTERNAL_API_TOKEN.
# BACKEND_INTERNAL_API_TOKEN=

# Spring Auth Feature Flag
# When true, admin login flows through Spring POST /api/v1/auth/login instead of NextAuth.
# Requires BACKEND_URL to be set.
# SPRING_AUTH_ENABLED=true
# NEXT_PUBLIC_SPRING_AUTH_ENABLED=true

# Email Configuration - Resend
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev

# File Upload - UploadThing
# Get your token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your_uploadthing_token_here

# NextAuth - Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
SESSION_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Admin bootstrap + notifications
# ADMIN_EMAIL is used for the initial seed and primary notification recipient.
# It does not restrict login to a single account.
ADMIN_EMAIL=admin@sparrhh.com
# Required by `npm run db:seed`. Generate a unique value in your ignored local .env.
# Example: openssl rand -base64 32
# ADMIN_PASSWORD=

# Sentry - Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Bot Verification - Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Shared rate limit store (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Admin audit retention purge (MIS-113)
# Secret used by scheduled job to call /api/internal/audit-retention
AUDIT_CRON_SECRET=your_audit_cron_secret

# CV retention purge (MIS Sprint Seguridad+Compliance)
# Secret used by scheduled job to call /api/internal/cv-retention
CV_RETENTION_CRON_SECRET=your_cv_retention_cron_secret
# Optional override (defaults to 180 days)
CV_RETENTION_DAYS=180

# Cross-origin allowlist (comma-separated origins)
# Example: http://localhost:3000,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Spring Boot vacancy access auth
# Required by the backend unless its explicitly configured local profile allows access.
# Generate a unique local token and set it in your ignored local .env. Do not use a shared default.
# RRHH_SECURITY_INTERNAL_API_TOKEN=

# Docker Compose local database
# Set a unique value in your ignored local .env before running docker compose.
# POSTGRES_PASSWORD=

# Public form validation policy
# Allowed email domains (comma-separated). Empty = no explicit allowlist.
# Example: empresa.com,clientes.org
FORM_ALLOWED_EMAIL_DOMAINS=
# Block disposable email providers in public forms
FORM_BLOCK_DISPOSABLE_EMAILS=true
# Optional client-side mirror for immediate UI feedback
NEXT_PUBLIC_FORM_ALLOWED_EMAIL_DOMAINS=
