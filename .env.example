# Environment variables for local development
# Copy this file to .env and fill in your values

# PostgreSQL Database URL
# Format: postgresql://USER@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/spa_rrhh_db?schema=public"

# Next.js
# NEXT_PUBLIC_ variables are exposed to the browser
NODE_ENV=development

# Email Configuration (Optional - for future implementation)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@your-domain.com

# NextAuth (Optional - for future admin authentication)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here
